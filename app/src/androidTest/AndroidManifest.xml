<!-- Test-only: CountingTreeProvider gives the sync tests a real SAF tree URI. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="org.missing_foss.trobar.CountingTreeProvider"
            android:authorities="org.missing_foss.trobar.test.tree"
            android:exported="true"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
