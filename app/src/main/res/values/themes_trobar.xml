<!-- Apply one overlay on top of the app theme (or via ContextThemeWrapper). The mark and wordmark drawables read these attrs. -->
<resources>
    <!-- Troubadour — Default · cream -->
    <style name="ThemeOverlay.Trobar.Troubadour" parent="">
        <item name="trobarGround">@color/trobar_troubadour_ground</item>
        <item name="trobarDisc">@color/trobar_troubadour_disc</item>
        <item name="trobarStar">@color/trobar_troubadour_star</item>
        <item name="trobarDot">@color/trobar_troubadour_dot</item>
        <item name="trobarText">@color/trobar_troubadour_text</item>
        <item name="trobarAccent">@color/trobar_troubadour_accent</item>
    </style>
